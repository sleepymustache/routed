{
  "name": "sleepy-mustache-routed",
  "description": "",
  "license": "GPL-2.0",
  "private": true,
  "engines": {
    "yarn": ">= 1.6",
    "node": ">= 14.00"
  },
  "scripts": {
    "init": "git submodule init && git submodule update && nvm install && nvm use && npm install",
    "build": "npm run init && node ./node_modules/gulp/bin/gulp.js build",
    "develop": "npm run start:app",
    "zip": "npm run build && node ./node_modules/gulp/bin/gulp.js zip",
    "cleanup": "npm run build && node ./node_modules/gulp/bin/gulp.js cleanup",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start:app": "npm run compose:docker && npm run install:app",
    "stop:app": "npm run config:export:drush && npm run clear-cache:drush && npm run save:database && docker-compose -f \"./docker/docker-compose.yml\" down",
    "save:database": "docker exec sleepy-db /bin/sh /dump-db.sh",
    "compose:docker": "docker-compose -f \"./docker/docker-compose.yml\" up -d --build",
    "install:app": "docker exec sleepy-php /bin/sh /setup.sh"
  },
  "devDependencies": {
    "babel-core": "^6.26.0",
    "babel-loader": "^7.1.3",
    "babel-plugin-transform-runtime": "^6.23.0",
    "babel-preset-env": "^1.6.1",
    "browser-sync": "^3.0.2",
    "eslint": "^9.1.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.7.0",
    "eslint-plugin-standard": "^5.0.0",
    "gulp": "~5.0.0",
    "gulp-eslint": "^4.0.2",
    "gulp-imagemin": "^4.1.0",
    "gulp-notify": "^3.2.0",
    "gulp-plumber": "^1.1.0",
    "gulp-sass": "^5.1.0",
    "gulp-sourcemaps": "^2.6.4",
    "gulp-zip": "^4.2.0",
    "sass": "^1.75.0",
    "webpack": "^5.91.0",
    "webpack-stream": "^7.0.0"
  },
  "dependencies": {
    "babel-runtime": "^6.26.0",
    "del": "^7.0.0"
  },
  "browserslist": [
    "defaults",
    "last 2 versions",
    "not dead",
    "IE 11"
  ]
}
